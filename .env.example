# --- Prisma / SQLite ---
# Use an absolute path. Replace with your own project root.
DATABASE_URL=file:/home/z/my-project/apps/75-multimodal-rag/db/custom.db

# --- LLM streaming ---
# The sandbox bundles z-ai-web-dev-sdk by default. To disable live LLM
# (e.g. for offline dev / CI), set this to 1 to use the MockProvider.
# MMRAG_DISABLE_LLM=1

# --- Embeddings ---
# Default: deterministic hashing-trick embedder (384-dim). No external API call.
# To use a real semantic embedding model, set ONE of the two API key vars
# AND (optionally) the base URL + model name. Any OpenAI-compatible endpoint
# works — Azure OpenAI, OpenRouter, Jina, Ollama, etc.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# --- Vision (image description for image chunks) ---
# When set, image chunks are described via z-ai-web-dev-sdk createVision.
# When unset, image chunks fall back to a placeholder description built from
# the "Figure X" caption text — keeps the MVP fully offline-runnable.
# MMRAG_ENABLE_VISION=1
